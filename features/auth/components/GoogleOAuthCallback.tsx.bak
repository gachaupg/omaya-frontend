"use client";

import React, { useEffect, useCallback } from "react";
import { useDispatch, useSelector } from "react-redux";
import { useRouter, useSearchParams } from "next/navigation";
import { 
  checkAuthStatus, 
  selectGoogleOAuthLoading,
  selectGoogleOAuthError,
  selectGoogleOAuthAuthenticated,
  selectGoogleOAuthUser
} from "../slices/googleOAuthSlice";
import { toast } from "react-toastify";

interface GoogleOAuthCallbackProps {
  onSuccess?: (userData: any) => void;
  onError?: (error: any) => void;
  redirectTo?: string;
}

const GoogleOAuthCallback: React.FC<GoogleOAuthCallbackProps> = ({
  onSuccess,
  onError,
  redirectTo = "/dashboard",
}) => {
  const dispatch = useDispatch();
  const router = useRouter();
  const searchParams = useSearchParams();
  
  const isLoading = useSelector(selectGoogleOAuthLoading);
  const error = useSelector(selectGoogleOAuthError);
  const isAuthenticated = useSelector(selectGoogleOAuthAuthenticated);
  const user = useSelector(selectGoogleOAuthUser);

  const handleSuccessfulAuth = useCallback((userData: any) => {
    console.log("✅ User is authenticated:", userData);
    toast.success("Google authentication successful!");
    onSuccess?.(userData);
    
    // Get the redirect URL from sessionStorage or use the default
    const redirectAfterLogin = sessionStorage.getItem('redirectAfterLogin') || redirectTo;
    sessionStorage.removeItem('redirectAfterLogin'); // Clean up
    
    // Redirect to the target page
    console.log(`🔄 Redirecting to: ${redirectAfterLogin}`);
    router.push(redirectAfterLogin);
  }, [onSuccess, redirectTo, router]);

  useEffect(() => {
    const checkAuth = async () => {
      try {
        console.log("🔍 Checking authentication status after OAuth callback...");
        
        if (!searchParams) {
          console.warn("⚠️ No search params available");
          return;
        }
        
        const code = searchParams.get('code');
        const error = searchParams.get('error');
        
        if (error) {
          console.error("❌ OAuth error in URL:", error);
          const errorMessage = `OAuth error: ${error}`;
          toast.error(errorMessage);
          onError?.({ message: errorMessage });
          router.push("/auth/login");
          return;
        }
        
        if (!code) {
          console.warn("⚠️ No authorization code found in URL");
          // If no code but no error, check if we're already authenticated
          const result = await dispatch(checkAuthStatus() as any);
          
          if (checkAuthStatus.fulfilled.match(result) && result.payload.isAuthenticated) {
            handleSuccessfulAuth(result.payload.user);
          } else {
            toast.error("No authorization code found. Please try logging in again.");
            router.push("/auth/login");
          }
          return;
        }
        
        // We have a code, proceed with authentication
        try {
          const result = await dispatch(checkAuthStatus() as any);
          
          if (checkAuthStatus.fulfilled.match(result)) {
            if (result.payload.isAuthenticated) {
              handleSuccessfulAuth(result.payload.user);
            } else {
              throw new Error("Authentication failed after receiving authorization code");
            }
          } else {
            throw new Error(result.payload || "Failed to verify authentication status");
          }
        } catch (authError) {
          console.error("❌ Authentication error:", authError);
          toast.error("Authentication failed. Please try again.");
          onError?.({ message: authError?.message || "Authentication failed" });
          router.push("/auth/login");
        }
      } catch (error) {
        console.error("❌ Error in OAuth callback:", error);
        const errorMessage = error?.message || "An error occurred during authentication";
        toast.error(errorMessage);
        onError?.({ message: errorMessage });
        router.push("/auth/login");
      }
    };

    checkAuth();
  }, [dispatch, searchParams, onSuccess, onError, redirectTo, router, handleSuccessfulAuth]);

  if (isLoading) {
    return (
        <div className="text-center">
          <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto mb-4"></div>
          <p className="text-gray-600 dark:text-gray-300">Completing authentication...</p>
        </div>
      </div>
    // Handle error state
  if (error) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div className="text-center">
          <div className="text-red-500 text-4xl mb-4">❌</div>
          <h1 className="text-2xl font-bold text-gray-800 mb-2">Authentication Error</h1>
          <p className="text-gray-600 mb-4">
            {error?.message || 'An error occurred during authentication'}
          </p>
          <button
            onClick={() => router.push('/auth/login')}
            className="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors"
          >
            Back to Login
          </button>
        </div>
      </div>
    );
  }

  // Default return for TypeScript
  return (
    <div className="flex items-center justify-center min-h-screen">
      <div className="text-center">
        <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto mb-4"></div>
        <p className="text-gray-700">Processing authentication...</p>
      </div>
    </div>
  );

          </p>
        </div>
      </div>
    );
  }

  return (
    <div className="flex items-center justify-center min-h-screen">
      <div className="text-center">
        <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto mb-4"></div>
        <p className="text-gray-700">Authenticating with Google...</p>
      </div>
    </div>
  );
}
};

export default GoogleOAuthCallback;
